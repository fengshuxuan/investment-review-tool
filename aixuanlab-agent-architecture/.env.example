# Volcengine Ark
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-pro-260628

# App
APP_NAME=aixuanlab-ai-agent
APP_ENV=development
API_PREFIX=/api

# Database
DATABASE_URL=sqlite:///./aixuanlab_agent.db

# File storage
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
PUBLIC_FILE_BASE_URL=http://localhost:8000/files

# Security
# In production, user_id should come from auth middleware/JWT/session, not request body.\AUTH_REQUIRED=false
